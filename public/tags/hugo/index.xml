    <item>
      <title>Hugo 友情連結模板</title>
      <link>http://localhost:1313/posts/hugo-friends/</link>
      <pubDate>Tue, 05 Oct 2021 14:14:10 +0800</pubDate><author>1024@lruihao.cn (Lruihao)</author>
      <guid>http://localhost:1313/posts/hugo-friends/</guid>
      <category domain="http://localhost:1313/categories/memo/">Memo</category>
