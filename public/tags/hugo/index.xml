path d=&#34;M610.1 372.3c-3.1-3.1-8.2-3.1-11.3 0L372.3 598.7c-3.1 3.1-3.1 8.2 0 11.3l39.6 39.6c3.1 3.1 8.2 3.1 11.3 0l226.4-226.4c3.1-3.1 3.1-8.2 0-11.3l-39.5-39.6z&#34; fill=&#34;#a9a9b3&#34;&gt;&lt;/path&gt;&lt;/svg&gt;&#xD;&#xA;          &lt;span class=&#34;cl-url&#34;&gt;github.com/Lruihao/FixIt&lt;/span&gt;&#xD;&#xA;        &lt;/span&gt;&#xD;&#xA;      &lt;/span&gt;&lt;img src=&#34;http://localhost:1313/images/remote/github_14075797050460861398.png&#34; alt=&#34;card image&#34; class=&#34;cl-shortcut-image&#34;&gt;&lt;/span&gt;&lt;/a&gt;</description>
