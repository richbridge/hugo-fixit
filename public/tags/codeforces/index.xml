    <item>
      <title>Adjacent Replacements</title>
      <link>http://localhost:1313/posts/adjacent-replacements/</link>
      <pubDate>Sun, 22 Jul 2018 11:54:14 +0800</pubDate><author>richffan@outlook.com (richfan)</author>
      <guid>http://localhost:1313/posts/adjacent-replacements/</guid>
      <category domain="http://localhost:1313/categories/acm/">ACM</category>
      <description>&lt;p&gt;&lt;a href=&#34;https://codeforces.com/contest/1006/problem/A&#34; target=&#34;_blank&#34; rel=&#34;external nofollow noopener noreferrer&#34;&gt;A. Adjacent Replacements&lt;i class=&#34;fa-solid fa-external-link-alt fa-fw fa-xs ms-1 text-secondary&#34; aria-hidden=&#34;true&#34;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;第一次打 cf 就做出一道这样的找规律的题，打到自闭。&lt;/p&gt;&#xA;&lt;pre&gt;&lt;code&gt;#include&amp;lt;bits/stdc&amp;#43;&amp;#43;.h&amp;gt;&#xA;using namespace std;&#xA;&#xA;int main(){&#xA;    int n,a[1001];&#xA;    cin&amp;gt;&amp;gt;n;&#xA;    int i;&#xA;    int flag=0;&#xA;    for(i=0;i&amp;lt;n;i&amp;#43;&amp;#43;){&#xA;        cin&amp;gt;&amp;gt;a[i];&#xA;        if(!(a[i]&amp;amp;1)) a[i]--;&#xA;        if(!flag) {cout&amp;lt;&amp;lt;a[i];flag=1;}&#xA;        else cout&amp;lt;&amp;lt;&amp;#34; &amp;#34;&amp;lt;&amp;lt;a[i];&#xA;    }&#xA;    return 0;&#xA;}&lt;/code&gt;&lt;/pre&gt;</description>
    </item>
    <item>
      <title>Educational Codeforces Round 47 (Rated for Div. 2)</title>
      <link>http://localhost:1313/posts/cf-1009/</link>
      <pubDate>Sun, 22 Jul 2018 11:25:56 +0800</pubDate><author>richffan@outlook.com (richfan)</author>
      <guid>http://localhost:1313/posts/cf-1009/</guid>
      <category domain="http://localhost:1313/categories/acm/">ACM</category>
      <description>&lt;p&gt;那天晚上报名了没打，第二天早上打的，也只出了两题。&lt;/p&gt;&#xA;&lt;h2 class=&#34;heading-element&#34; id=&#34;a-game-shopping&#34;&gt;&lt;span&gt;7 &lt;a href=&#34;https://codeforces.com/contest/1009/problem/A&#34; target=&#34;_blank&#34; rel=&#34;external nofollow noopener noreferrer&#34;&gt;A. Game Shopping&lt;i class=&#34;fa-solid fa-external-link-alt fa-fw fa-xs ms-1 text-secondary&#34; aria-hidden=&#34;true&#34;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/span&gt;&#xD;&#xA;  &lt;a href=&#34;#a-game-shopping&#34; class=&#34;heading-mark&#34;&gt;&#xD;&#xA;    &lt;svg class=&#34;octicon octicon-link&#34; viewBox=&#34;0 0 16 16&#34; version=&#34;1.1&#34; width=&#34;16&#34; height=&#34;16&#34; aria-hidden=&#34;true&#34;&gt;&lt;path d=&#34;m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z&#34;&gt;&lt;/path&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&#xD;&#xA;&lt;/h2&gt;&lt;pre&gt;&lt;code&gt;#include&amp;lt;iostream&amp;gt;&#xA;using namespace std;&#xA;&#xA;int main(){&#xA;    int n,m,s=0;&#xA;    cin&amp;gt;&amp;gt;n&amp;gt;&amp;gt;m;&#xA;    int i,j;&#xA;    int c[1000],a[1000];&#xA;    for(i=0;i&amp;lt;n;i&amp;#43;&amp;#43;)&#xA;        cin&amp;gt;&amp;gt;c[i];&#xA;    for(i=0;i&amp;lt;m;i&amp;#43;&amp;#43;)&#xA;        cin&amp;gt;&amp;gt;a[i];&#xA;    for(i=0,j=0;i&amp;lt;n;){&#xA;        if(j==m)&#xA;            break;&#xA;        if(c[i]&amp;lt;=a[j]){&#xA;            s&amp;#43;&amp;#43;;&#xA;            j&amp;#43;&amp;#43;;&#xA;            i&amp;#43;&amp;#43;;&#xA;        }&#xA;        else i&amp;#43;&amp;#43;;&#xA;    }&#xA;    if(i==n&amp;amp;&amp;amp;s==0)&#xA;        cout&amp;lt;&amp;lt;&amp;#34;0\n&amp;#34;;&#xA;    else cout&amp;lt;&amp;lt;s&amp;lt;&amp;lt;endl;&#xA;    return 0;&#xA;}&lt;/code&gt;&lt;/pre&gt;&lt;h2 class=&#34;heading-element&#34; id=&#34;b-minimum-ternary-string&#34;&gt;&lt;span&gt;8 &lt;a href=&#34;https://codeforces.com/contest/1009/problem/B&#34; target=&#34;_blank&#34; rel=&#34;external nofollow noopener noreferrer&#34;&gt;B. Minimum Ternary String&lt;i class=&#34;fa-solid fa-external-link-alt fa-fw fa-xs ms-1 text-secondary&#34; aria-hidden=&#34;true&#34;&gt;&lt;/i&gt;&lt;/a&gt;&lt;/span&gt;&#xD;&#xA;  &lt;a href=&#34;#b-minimum-ternary-string&#34; class=&#34;heading-mark&#34;&gt;&#xD;&#xA;    &lt;svg class=&#34;octicon octicon-link&#34; viewBox=&#34;0 0 16 16&#34; version=&#34;1.1&#34; width=&#34;16&#34; height=&#34;16&#34; aria-hidden=&#34;true&#34;&gt;&lt;path d=&#34;m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z&#34;&gt;&lt;/path&gt;&lt;/svg&gt;&#xD;&#xA;  &lt;/a&gt;&#xD;&#xA;&lt;/h2&gt;&lt;pre&gt;&lt;code&gt;#include &amp;lt;bits/stdc&amp;#43;&amp;#43;.h&amp;gt;&#xA;using namespace std;&#xA;&#xA;string s, ans;&#xA;&#xA;int main(){&#xA;    cin &amp;gt;&amp;gt; s;&#xA;    int one = 0;&#xA;    for (int i = 0; i &amp;lt; s.size(); i&amp;#43;&amp;#43;){&#xA;        if (s[i] == &amp;#39;0&amp;#39;) ans &amp;#43;= &amp;#34;0&amp;#34;;&#xA;        if (s[i] == &amp;#39;1&amp;#39;) one&amp;#43;&amp;#43;;&#xA;        if (s[i] == &amp;#39;2&amp;#39;) ans &amp;#43;= &amp;#34;2&amp;#34;;&#xA;    }&#xA;    bool flag = false;&#xA;    for (int i = 0; i &amp;lt; ans.size(); i&amp;#43;&amp;#43;){&#xA;        if (ans[i] == &amp;#39;2&amp;#39; &amp;amp;&amp;amp; !flag) flag = true, cout &amp;lt;&amp;lt; string(one, &amp;#39;1&amp;#39;);&#xA;        cout &amp;lt;&amp;lt; ans[i];&#xA;    }&#xA;    if (!flag) cout &amp;lt;&amp;lt; string(one, &amp;#39;1&amp;#39;);&#xA;    return 0;&#xA;}&#xA;&#xA;/*&#xA;&#xA;100210&#xA;&#xA;11222121&#xA;&#xA;20&#xA;&#xA;2001&#xA;&#xA;020201&#xA;&#xA;2012101&#xA;&#xA;111&#xA;&#xA;000&#xA;&#xA;*/&lt;/code&gt;&lt;/pre&gt;</description>
    </item>
